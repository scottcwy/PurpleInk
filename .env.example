# PurpleInk — Next 应用进程环境模板（对照 git 忽略的根目录 `.env.local`）
#
# 只列 Next 进程直接消费的变量。
# 后端 worker（`server/`）模板在 `server/.env.example`。供应商凭据与 TTS
# 路由只属于 Next；worker 仅持有服务间密钥与 Next 网关地址。
#
# 安全约束（AGENTS.md §7）：
#   - secret 类变量（API key / master key / 口令）值必须留空。
#   - 真实值只写在被忽略的 `.env.local`；禁止提交、禁止硬编码进源码或本文件。
#   - 禁止携带 secret 的 `NEXT_PUBLIC_*`。
#
# 本地冷启动最小集（与当前 `.env.local` 变量名对齐）：
#   DATABASE_URL / TEST_DATABASE_URL / CVC_CREDENTIAL_MASTER_KEY
#   CVC_MANAGED_STEPFUN_API_KEY / CVC_MANAGED_MIMO_API_KEY / CVC_MANAGED_GEMINI_API_KEY
#   CVC_MANAGED_OPENAI_API_KEY / CVC_MANAGED_ANTHROPIC_API_KEY

# --- 数据库与凭据加密（仅 Next） ---
DATABASE_URL=postgres://cvc:cvc_dev_only@127.0.0.1:54328/cvc
TEST_DATABASE_URL=postgres://cvc:cvc_dev_only@127.0.0.1:54328/cvc_test
# 凭据加密主密钥：32 字节 canonical base64。缺失即抛错、无明文 fallback。
# 首初始化用 `pnpm tsx scripts/migration/provision-master-key.ts --env .env.local` 生成。
CVC_CREDENTIAL_MASTER_KEY=

# --- 平台托管 AI 凭据（仅 server-only 运行时读取）---
#
# 五家内置服务只读取下列变量；不得写入数据库、客户端、日志或错误。
CVC_MANAGED_STEPFUN_API_KEY=
CVC_MANAGED_MIMO_API_KEY=
CVC_MANAGED_GEMINI_API_KEY=
CVC_MANAGED_OPENAI_API_KEY=
CVC_MANAGED_ANTHROPIC_API_KEY=

# --- 前端反代到后端 worker（next.config.ts:30 rewrites 直接消费）---
# 默认 http://localhost:8787；本地 worker 默认在这个端口。
BACKEND_ORIGIN=
# 浏览器直连后端的覆盖路径，留空则走同源 /api/engine（src/lib/api.ts:6-7）。
NEXT_PUBLIC_API_BASE=
# Next 调用 worker /internal/* 的 server-only 鉴权密钥。开发环境可只在根
# .env.local 配置，worker 会加载同一文件；分离部署时两端必须注入完全相同的值。
PURPLEINK_ENGINE_INTERNAL_KEY=

# --- AI 并发保护发布开关（留空分别等价于 enforce / 100）---
AI_PROVIDER_POOL_MODE=
AI_SHOT_CONCURRENCY_ENFORCEMENT_PERCENT=

# --- 取证脚本的反代 Basic Auth 凭据（仅 scripts/verify/e2e-smoke.ts 消费）---
# 格式 user:pass；反代（ISSUE-015 P-2，见 docs/deployment/access.md）启用 Basic Auth
# 后取证脚本需要这个入口才能通过反代，未设置时行为与之前完全一致（不发该头）。
CVC_VERIFY_BASIC_AUTH=

# --- 取证脚本的应用内登录账号（仅 scripts/verify/e2e-smoke.ts 消费）---
# 格式 email:password，必须是真实注册账号（PLAN-002 阶段 B 后业务 API 要求会话）。
# 脚本先调 /api/auth/login 拿会话 cookie，后续请求携带；未设置时如实提示并继续
# （请求会被 401 拒绝）。secret 性质：值必须留空，真实值只写 .env.local。
CVC_VERIFY_ACCOUNT=

# --- 认证验证码的出站邮件通道（阿里云邮件推送 SMTP，src/features/auth/mailer.ts 消费）---
#
# Next 侧不读 server/.env。真实值从 server/.env 的同类 SMTP_* 变量「复制值」到被
# git 忽略的根 .env.local（两套进程环境各自为政，见
# docs/configuration/credentials.md）。
#
# 与 server/.env 的 IMAP_* 是两件事：那边是采集 agent 出站登录被演示站点时**收**
# 验证码；这里是 PurpleInk 自己**发**注册/重置验证码（PLAN-002 §6）。
#
# 任何一项缺失即视为通道未配置：/api/auth/*/code 会如实回 503 类别文案，
# 不会静默假装已发送。
CVC_MAIL_SMTP_HOST=
CVC_MAIL_SMTP_PORT=
CVC_MAIL_SMTP_USER=
# secret：SMTP 口令，值必须留空（AGENTS.md §7）。
CVC_MAIL_SMTP_PASS=
CVC_MAIL_FROM_ADDRESS=
CVC_MAIL_FROM_NAME=

# --- 体验账号建号凭据（仅 scripts/setup/seed-owner-account.ts --from-env 消费）---
#
# 登录页的体验账号提示弹窗已移除，这组变量不再被任何页面读取、不会下发到
# 浏览器。它们只剩一个用途：容器编排（docker-compose.prod.yml 的
# seed-demo-account 服务）或本地手动执行建号脚本时提供凭据：
#   pnpm tsx scripts/setup/seed-owner-account.ts --from-env
# 未设置时脚本原地退出 0，什么也不做。
CVC_DEMO_ACCOUNT_EMAIL=
CVC_DEMO_ACCOUNT_PASSWORD=
# 体验账号显示名，留空走脚本内置默认值。
CVC_DEMO_ACCOUNT_NAME=
