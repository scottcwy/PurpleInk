# PurpleInk Script Video CLI local configuration.
# Keep real values in an ignored .env.local or inject them from the shell.
# Never commit API keys and never expose them through NEXT_PUBLIC_* variables.

SCRIPT_VIDEO_PROVIDER=openai-compatible
SCRIPT_VIDEO_AI_BASE_URL=
SCRIPT_VIDEO_AI_API_KEY=
SCRIPT_VIDEO_AI_MODEL=
SCRIPT_VIDEO_AI_VISION_MODEL=
SCRIPT_VIDEO_AI_TIMEOUT_MS=120000
SCRIPT_VIDEO_AI_MAX_RETRIES=2
SCRIPT_VIDEO_AI_RETRY_DELAY_MS=250
SCRIPT_VIDEO_CONCURRENCY=4
SCRIPT_VIDEO_BROWSER_GATE=true
SCRIPT_VIDEO_STATE_DIR=.purpleink/runs
