# 每日 pg_dump → Cloudflare R2 的备份容器。
#
# 独立常驻服务（Zeabur 无私网可达的 cron 服务类型）：CMD 是
# scripts/backup/schedule.ts（Node 调度，继承容器 env，secret 不落盘）。
#
# pg_dump 客户端大版本与 Zeabur 官方 PostgreSQL 模板（postgres:17.5）对齐；
# 若面板实际部署的 PG 大版本不同，需同步调整 postgresql-client 版本
# （pg_dump 版本必须 >= 服务器大版本）。
FROM node:22-bookworm-slim AS deps
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN corepack enable && corepack prepare pnpm@10.30.0 --activate
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY patches patches
COPY server/package.json server/package.json
COPY packages/procedural-sfx/package.json packages/procedural-sfx/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS backup
# PGDG 源安装 postgresql-client-17（bookworm 自带客户端是 15，低于 17 服务器不可用）。
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --yes --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
        | gpg --dearmor -o /usr/share/keyrings/pgdg.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install --yes --no-install-recommends \
        postgresql-client-17 \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY scripts/backup ./scripts/backup
CMD ["pnpm", "tsx", "scripts/backup/schedule.ts"]
