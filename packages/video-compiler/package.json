{
  "name": "@purpleink/video-compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic LaunchVideoPlanV1 to Hyperframes CompositionBundleV1 compiler",
  "type": "module",
  "exports": "./src/index.mjs",
  "scripts": {
    "compile:golden": "node scripts/compile-fixture.mjs fixtures/golden-feature-launch/input.json fixtures/golden-feature-launch/bundle",
    "quality:golden": "node scripts/quality-gate.mjs fixtures/golden-feature-launch/bundle fixtures/golden-feature-launch/quality-report.json",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node --check src/compile.mjs && node --check src/index.mjs",
    "lint": "node scripts/check-source.mjs"
  },
  "devDependencies": {
    "hyperframes": "0.7.68"
  }
}
