{
  "name": "@purpleink/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "npm run lint:web && npm run lint --workspaces --if-present",
    "lint:web": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --ignore-pattern packages",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix --ignore-pattern packages",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "npm run typecheck:web && npm run typecheck --workspaces --if-present",
    "typecheck:web": "tsc --noEmit",
    "test": "npm run test:web && npm run test --workspaces --if-present",
    "test:web": "node --test tests/*.test.mjs && vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "vitest run tests/database-contracts.test.ts"
  },
  "dependencies": {
    "@purpleink/r2-store": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.14.2",
    "lenis": "^1.3.3",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
