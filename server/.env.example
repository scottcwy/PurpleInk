# PurpleInk server/ worker 环境模板（对应 git 忽略的 `server/.env`）
#
# 与根目录 `.env.example` / `.env.local` 各自为政，不交叉作为唯一真值。
# worker 启动会依次 load：`server/.env` → 仓库根 `.env.local`（后者可覆盖同名键）。
# secret 类变量值必须留空；真实值只写在被忽略的 `server/.env`。

# --- IMAP 真实邮箱收验证码（自助注册时用；填测试账号则可留空）---
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
SIGNUP_PASSWORD=

# --- 浏览器驱动 playwright / mock ---
BROWSER_DRIVER=playwright

# --- Next ↔ worker 服务间边界 ---
# 同一密钥同时保护 Next → worker 的 /internal/* 与 worker → Next 的
# /api/internal/ai/worker。worker 不再持有任何供应商 Key、模型 ID 或渠道 URL。
PURPLEINK_ENGINE_INTERNAL_KEY=
# 本地默认 Next 地址；容器内由 compose 固定为 http://next:3000。
PURPLEINK_AI_GATEWAY_ORIGIN=http://localhost:3000

# 阿里云邮件推送
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=PurpleInk
