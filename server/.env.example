# PurpleInk server/ worker 环境模板（对应 git 忽略的 `server/.env`）
#
# 与根目录 `.env.example` / `.env.local` 各自为政，不交叉作为唯一真值。
# worker 启动会依次 load：`server/.env` → 仓库根 `.env.local`（后者可覆盖同名键）。
# secret 类变量值必须留空；真实值只写在被忽略的 `server/.env`。

# --- render_jobs 落库（管理后台任务监控）---
# 本地开发通常不用填：worker 会接着加载仓库根 `.env.local`，复用那边的
# DATABASE_URL。未设置时任务不落库（只在启动时 warn 一次），渲染不受影响。
DATABASE_URL=

# --- StepFun 多模态 LLM（采集决策 + 资产描述 + 分镜编导）---
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
# 文本（采集决策/分镜）模型
STEP_MODEL=step-explore
# 视觉（截图描述）模型—— step-explore 不吃图片，多模态用 step-3.7-flash
STEP_VISION_MODEL=step-3.7-flash
STEP_MIN_INTERVAL_MS=7000
STEP_MAX_RETRIES=4

# --- IMAP 真实邮箱收验证码（自助注册时用；填测试账号则可留空）---
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
SIGNUP_PASSWORD=

# --- 浏览器驱动 playwright / mock ---
BROWSER_DRIVER=playwright

# --- ListenHub FlowSpeech TTS（旁白合成；密钥留空）---
# 非密钥默认值与 `config/tts.env.example`、`docs/configuration/tts.md` 对齐。
# 根目录 `.env.example` 故意不包含 TTS（见 tests/env.test.ts）。
TTS_PROVIDER=listenhub-flowspeech
LISTENHUB_API_KEY=
LISTENHUB_API_BASE_URL=https://api.marswave.ai/openapi
LISTENHUB_TTS_ENDPOINT=/v1/tts
LISTENHUB_TTS_VOICE=nanzhongyin-4897116a
LISTENHUB_TTS_RESPONSE_FORMAT=mp3

# --- Gemini（Google 官方 OpenAI 兼容端点）---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# 阿里云邮件推送
SMTP_HOST=smtpdm.aliyun.com  
SMTP_PORT=465  
SMTP_USER=  
SMTP_PASS=  
SMTP_FROM_NAME=PurpleInk  