# StepFun 多模态 LLM（采集决策 + 资产描述 + 分镜编导）
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
# 文本（采集决策/分镜）模型
STEP_MODEL=step-explore
# 视觉（截图描述）模型—— step-explore 不吃图片，多模态用 step-3.7-flash
STEP_VISION_MODEL=step-3.7-flash
STEP_MIN_INTERVAL_MS=7000
STEP_MAX_RETRIES=4

# IMAP 真实邮箱收验证码（自助注册时用；填测试账号则可留空）
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
SIGNUP_PASSWORD=

# 浏览器驱动 playwright / mock（M3 接入）
BROWSER_DRIVER=playwright
