# PurpleInk 生产反代（Caddy）。
#
# 设计要点（对应 docs/plans/PLAN-001-p2-p6-p7-production-deployment.md §1）：
#   1. 默认拒绝，不做路径白名单——basic_auth 与 IP 过滤应用在 catch-all 的 :443
#      块上，覆盖 next 容器的全部路径（/、/products/*、/api/*、/api/engine/* ...）。
#      不要为任何路径（含健康检查、监控、webhook）单独开豁免 location。
#   2. 放行 SSE——flush_interval -1 关闭缓冲；不对响应做 gzip（text/event-stream
#      若被压缩会破坏分块流，等价于 nginx 侧把它排除在 gzip_types 之外，这里选择
#      直接不启用 encode，避免遗漏）。
#   3. 网络层 + Basic Auth 组合——remote_ip 过滤是第一道（默认放行所有网段，
#      生产必须把 CVC_ALLOWED_CIDRS 收紧成真实网段/VPN 出口 IP），Basic Auth over
#      TLS 是第二道。两道都对浏览器原生 EventSource 透明。
#   4. TLS 必须有——`tls internal` 用 Caddy 内置 CA 签发自签证书，足够本地/内网
#      验证；有真实域名时改成 `tls {$CVC_TLS_EMAIL}` 或直接把 `:443` 换成域名块
#      以启用自动 Let's Encrypt。证书信任步骤见 docs/deployment/access.md。
#
# 变量来源：docker-compose.prod.yml 的 reverse-proxy 服务 environment / entrypoint.sh
# 从 compose secret 文件注入，Caddyfile 本身不含任何明文口令。

{
	admin off
}

:443 {
	# 站点地址是纯端口（无域名），Caddy 没有固定 hostname 可以提前签发证书；
	# 加 on_demand 让它按握手时的 SNI 现场签发——用的是 Caddy 自己的内部 CA，
	# 不会消耗任何外部 CA 的签发额度。实测过：不加 on_demand 时任何请求都会在
	# TLS 握手阶段收到 "internal error"（Caddy 找不到证书可用）。生产换真实
	# 域名后（见 docs/deployment/access.md §5.2），改回普通 `tls internal`
	# 或直接用域名块以启用自动 ACME。
	tls internal {
		on_demand
	}

	# 网络层过滤：默认放行所有网段（0.0.0.0/0 ::/0），生产必须收紧。
	@blocked not remote_ip {$CVC_ALLOWED_CIDRS}
	respond @blocked 403

	basic_auth {
		{$CVC_BASIC_AUTH_USER} {$CVC_BASIC_AUTH_HASH}
	}

	reverse_proxy next:3000 {
		flush_interval -1
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}
