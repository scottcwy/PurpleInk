PURPLEINK_DOMAIN=shuheng.cloud
IMAGE_TAG=sha-replace_with_commit
POSTGRES_DB=purpleink
POSTGRES_USER=purpleink
POSTGRES_PASSWORD=replace_with_url_safe_random_password
DATABASE_URL=postgres://purpleink:replace_with_url_safe_random_password@postgres:5432/purpleink
CVC_CREDENTIAL_MASTER_KEY=replace_with_32_byte_canonical_base64
# 产物对象存储：留空或 local 保持纯本地盘；s3-mirror 启用 R2 写穿（四项 S3_* 必填）。
STORAGE_MODE=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=

# ================= worker 服务变量 =================
# 与上面同一份文件：deploy/compose.yaml 的 worker 服务 env_file 读取
# ${ENV_FILE:-.env}（合并自原 worker.env.example；代码消费名是 STEP_BASE_URL）。
STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1
STEP_MODEL=step-explore
STEP_VISION_MODEL=step-3.7-flash
BROWSER_DRIVER=playwright
PURPLEINK_COMPOSE_MODE=auto
TTS_PROVIDER=listenhub-flowspeech
LISTENHUB_API_KEY=
LISTENHUB_API_BASE_URL=https://api.marswave.ai/openapi
LISTENHUB_TTS_ENDPOINT=/v1/tts
LISTENHUB_TTS_VOICE=nanzhongyin-4897116a
LISTENHUB_TTS_RESPONSE_FORMAT=mp3
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
SIGNUP_PASSWORD=
