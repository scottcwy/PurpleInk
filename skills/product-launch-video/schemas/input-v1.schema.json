{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://purpleink.local/schemas/product-launch-video-input-v1.json",
  "title": "LaunchVideoSkillInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workspaceId", "productId", "releaseId", "releaseBriefVersionId", "storyboardVersionId", "productFlowVersionId", "captureRunId", "brandKitVersionId", "evidencePackageVersionId", "templateVersion", "locale", "targetDurationMs", "storyboard", "brandKit", "evidencePackage", "templateCapabilities"],
  "properties": {
    "schemaVersion": { "const": "launch-video-skill-input/v1" },
    "workspaceId": { "$ref": "#/definitions/id" },
    "productId": { "$ref": "#/definitions/id" },
    "releaseId": { "$ref": "#/definitions/id" },
    "releaseBriefVersionId": { "$ref": "#/definitions/id" },
    "storyboardVersionId": { "$ref": "#/definitions/id" },
    "productFlowVersionId": { "$ref": "#/definitions/id" },
    "captureRunId": { "$ref": "#/definitions/id" },
    "brandKitVersionId": { "$ref": "#/definitions/id" },
    "evidencePackageVersionId": { "$ref": "#/definitions/id" },
    "templateVersion": { "type": "string", "pattern": "^feature-launch@[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
    "targetDurationMs": { "type": "integer", "minimum": 15000, "maximum": 30000 },
    "storyboard": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspaceId", "productId", "releaseId", "approvalStatus", "immutable", "scenes"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "workspaceId": { "$ref": "#/definitions/id" }, "productId": { "$ref": "#/definitions/id" }, "releaseId": { "$ref": "#/definitions/id" },
        "approvalStatus": { "const": "approved" }, "immutable": { "const": true },
        "scenes": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "$ref": "#/definitions/storyboardScene" } }
      }
    },
    "brandKit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workspaceId", "productId", "releaseId", "approvalStatus", "immutable", "colors", "fonts"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "workspaceId": { "$ref": "#/definitions/id" }, "productId": { "$ref": "#/definitions/id" }, "releaseId": { "$ref": "#/definitions/id" },
        "approvalStatus": { "const": "approved" }, "immutable": { "const": true },
        "colors": { "type": "object", "minProperties": 3, "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
        "fonts": { "type": "object", "additionalProperties": false, "required": ["display", "body", "mono"], "properties": { "display": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 }, "mono": { "type": "string", "minLength": 1 } } }
      }
    },
    "evidencePackage": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "id", "workspaceId", "productId", "releaseId", "captureRunId", "approvalStatus", "immutable", "refs", "provenance", "sha256", "entries"],
      "properties": {
        "schemaVersion": { "const": "evidence-package/v1" },
        "id": { "$ref": "#/definitions/id" }, "workspaceId": { "$ref": "#/definitions/id" }, "productId": { "$ref": "#/definitions/id" }, "releaseId": { "$ref": "#/definitions/id" },
        "captureRunId": { "$ref": "#/definitions/id" },
        "approvalStatus": { "const": "approved" }, "immutable": { "const": true }, "sha256": { "$ref": "#/definitions/hash" },
        "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidenceRef" } },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["flowVersionId", "manifestHash", "workerImageDigest"],
          "properties": {
            "flowVersionId": { "$ref": "#/definitions/id" },
            "manifestHash": { "$ref": "#/definitions/hash" },
            "workerImageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          }
        },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/evidence" } }
      }
    },
    "templateCapabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["templateVersion", "layoutIds", "motionPresetIds", "transitionIds", "copyLimits"],
      "properties": {
        "templateVersion": { "type": "string" },
        "layoutIds": { "$ref": "#/definitions/idList" }, "motionPresetIds": { "$ref": "#/definitions/idList" }, "transitionIds": { "$ref": "#/definitions/idList" },
        "copyLimits": { "type": "object", "additionalProperties": false, "required": ["headlineMaxChars", "bodyMaxChars"], "properties": { "headlineMaxChars": { "type": "integer", "minimum": 1, "maximum": 120 }, "bodyMaxChars": { "type": "integer", "minimum": 1, "maximum": 240 } } }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "nodeEvidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "nodeEvidenceId", "assetVersionId"],
      "properties": { "kind": { "const": "node_evidence" }, "nodeEvidenceId": { "$ref": "#/definitions/id" }, "assetVersionId": { "$ref": "#/definitions/id" } }
    },
    "sourceAssetRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sourceAssetId", "assetVersionId"],
      "properties": { "kind": { "const": "source_asset" }, "sourceAssetId": { "$ref": "#/definitions/id" }, "assetVersionId": { "$ref": "#/definitions/id" } }
    },
    "evidenceRef": { "oneOf": [{ "$ref": "#/definitions/nodeEvidenceRef" }, { "$ref": "#/definitions/sourceAssetRef" }] },
    "storyboardScene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "releaseId", "capabilityId", "claimType", "headline", "body", "evidence"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "order": { "type": "integer", "minimum": 1 }, "releaseId": { "$ref": "#/definitions/id" },
        "capabilityId": { "$ref": "#/definitions/id" }, "claimType": { "enum": ["browser_behavior", "static_media", "non_factual"] },
        "headline": { "type": "string", "minLength": 1, "maxLength": 120 }, "body": { "type": "string", "maxLength": 240 },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceRef" } }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "assetVersionId", "sceneIds", "workspaceId", "productId", "releaseId", "approvalStatus", "redactionStatus", "immutable", "assetKind", "mimeType", "bytes", "sha256", "bundlePath", "contentBase64"],
      "properties": {
        "ref": { "$ref": "#/definitions/evidenceRef" }, "assetVersionId": { "$ref": "#/definitions/id" }, "sceneIds": { "$ref": "#/definitions/idList" },
        "workspaceId": { "$ref": "#/definitions/id" }, "productId": { "$ref": "#/definitions/id" }, "releaseId": { "$ref": "#/definitions/id" },
        "approvalStatus": { "const": "approved" }, "redactionStatus": { "const": "passed" }, "immutable": { "const": true },
        "assetKind": { "enum": ["result_screenshot", "node_clip", "uploaded_source"] }, "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml", "video/mp4", "video/webm"] },
        "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/definitions/hash" },
        "bundlePath": { "type": "string", "pattern": "^assets/[A-Za-z0-9._/-]+$", "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        "contentBase64": { "type": "string", "minLength": 4 }
      }
    }
  }
}
